# Dónde está cada cosa. Copiar como medicci.conf y poner lo que diga el hospital
# o el pliego. Lo leen el servidor (mvp/servidor.py), el emisor HL7 y la burbuja
# (medicci-rs). Una variable de entorno con el mismo nombre manda sobre esto.

# --- El modelo de IA: cualquier servidor compatible con la API de OpenAI -------
# Ollama en el mismo equipo, vLLM en un Spark del CPD, o el que diga el pliego.
MEDICCI_URL=http://localhost:11434/v1
MEDICCI_MODELO=qwen3:8b
# Si ese servidor pide clave:
# MEDICCI_CLAVE=

# --- El servidor de Medicci -----------------------------------------------------
# Dónde escucha (0.0.0.0 para que lleguen otros equipos) y en qué puerto.
MEDICCI_ESCUCHA=127.0.0.1
MEDICCI_PUERTO=8000
# Dónde lo buscan la burbuja y el emisor: http(s)://nombre-o-ip:puerto
MEDICCI_SERVIDOR=http://localhost:8000

# --- Los datos -----------------------------------------------------------------
# csv: lee data/; hl7: copia vacía que se llena con mensajes HL7.
MEDICCI_DATOS=csv
# Puerto donde el receptor HL7 de Medicci escucha al motor de integración.
MEDICCI_HL7_PUERTO=2575
# Solo para la demo: a qué equipo manda el emisor que hace de HCIS.
MEDICCI_HL7_HOST=localhost
# Solo para la demo: suma los crónicos sintéticos de data/generados a la agenda.
MEDICCI_GENERADOS=si

# --- El dictado por voz (mvp/voz.py) --------------------------------------------
# Whisper en local: small (rápido), medium o large-v3-turbo (acierta más con
# términos médicos, más lento en procesador). O la ruta de un modelo descargado.
MEDICCI_VOZ_MODELO=small
# cpu deja la VRAM para el modelo de lenguaje; cuda solo si sobra memoria.
MEDICCI_VOZ_DISPOSITIVO=cpu
